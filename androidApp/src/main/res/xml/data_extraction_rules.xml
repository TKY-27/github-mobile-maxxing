<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 (API 31) and later. Imported font files (filesDir/custom_fonts) are left out of cloud
    backups and device transfers. Only exclude rules are used, so everything else (settings and
    other app data) is still included.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="custom_fonts/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="custom_fonts/" />
    </device-transfer>
</data-extraction-rules>
